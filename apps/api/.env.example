# Copie para .env antes de rodar em desenvolvimento: cp .env.example .env

# Conexão com o Postgres (o docker-compose.yml da raiz sobe um compatível).
DATABASE_URL="postgresql://eteg:eteg@localhost:5432/eteg?schema=public"

# Porta HTTP da API.
PORT=3000

# development | test | production
NODE_ENV=development

# Origens liberadas no CORS, separadas por vírgula.
# Em desenvolvimento o front roda em outra porta; em produção API e front
# são servidos pela mesma origem e isto pode ficar vazio.
ORIGENS_PERMITIDAS="http://localhost:5173"

# fatal | error | warn | info | debug | trace
NIVEL_DE_LOG=info
